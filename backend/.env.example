JWT_SECRET=
REFRESH_SECRET=
SALTING=
API_URL='http://localhost:8000/api/v1'
RATE_LIMIT_WINDOW_MINUTES=
RATE_LIMIT_MAX_REQUESTS=
EMAIL_ID=
RESEND_API_KEY=
NODE_ENV=
REFRESH_TTL=                         #number of days for refresh token
ACCESS_TTL=                          #access token time in minitues ie.15

# ── Birthday Feature ────────────────────────────────────────────
# Secret header value required to call POST /api/v1/birthdays/run-job and /test-email
BIRTHDAY_JOB_SECRET=

# Shared internal service credential to authenticate with Central Backend.
# Must equal INTERNAL_SERVICE_SECRET on the central API (COC-API).
# INTERNAL_SERVICE_SECRET is also accepted here as a fallback name.
# The scheduler does not start when this is empty.
BIRTHDAY_SERVICE_SECRET=

# Set to "false" to disable the in-process 9 AM IST scheduler (e.g. in dev).
# When running more than one backend instance, enable it on one instance only.
BIRTHDAY_SCHEDULER_ENABLED=false

# Timezone and execution schedule
BIRTHDAY_TIMEZONE=Asia/Kolkata
BIRTHDAY_SCHEDULE_HOUR=9
BIRTHDAY_SCHEDULE_MINUTE=0

# Retry worker polling interval and batch configuration
BIRTHDAY_RETRY_POLL_INTERVAL_MS=60000
BIRTHDAY_BATCH_SIZE=10
BIRTHDAY_WORKER_CONCURRENCY=2
BIRTHDAY_PROCESSING_LEASE_MS=300000

